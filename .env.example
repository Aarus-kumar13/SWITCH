# SWITCH Environment Configuration

# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Provider Models Selection
DEFAULT_FAST_MODEL=gpt-4o-mini
DEFAULT_REASONING_MODEL=gpt-4o
DEFAULT_VISION_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Database & Cache
DATABASE_URL=postgresql+asyncpg://switch_user:switch_password@localhost:5432/switch_db
REDIS_URL=redis://localhost:6379/0

# Desktop Agent Auth & Config
DESKTOP_AGENT_TOKEN=switch_local_desktop_secret_token_123
DESKTOP_AGENT_URL=http://localhost:8001

# Telephony (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
USER_REGISTERED_PHONE=+1987654321

# Web Frontend URL
WEB_FRONTEND_URL=http://localhost:3000
